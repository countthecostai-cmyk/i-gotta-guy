# Supabase (required — see supabase/migrations for the schema to apply)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for SEO metadata + Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (optional — omit to run in demo payment mode, see src/lib/payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
